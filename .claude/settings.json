{
  "permissions": {
    "deny": [
      "Read(~/Developer/soul-dreams-docs/**)",
      "Read(~/Developer/soul-dreams/**)",
      "Read(~/.soul-dreams/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/Library/CloudStorage/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Read(~/Downloads/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Edit(/app/assets/words/**)",
      "Edit(/app/lib/words/**)",
      "Edit(/docs/source/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git config *)",
      "Bash(git commit -n *)",
      "Bash(* --no-verify*)",
      "Bash(flutter run *)",
      "Bash(flutter install *)",
      "Bash(xcrun simctl *)",
      "Bash(open -a Simulator*)",
      "Bash(aws *)",
      "Bash(npx cdk *)",
      "Bash(cdk *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git reset *)",
      "Bash(git commit -n*)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(fvm flutter run *)",
      "Bash(fvm flutter install *)",
      "Bash(fvm use *)",
      "Bash(fvm install *)",
      "Bash(fvm global *)",
      "Edit(/.git/config)",
      "Edit(/.git/hooks/**)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/docs/workflow.md)",
      "Edit(/.githooks/**)",
      "Edit(/tool/checks/**)",
      "Edit(/tool/check_all.sh)",
      "Edit(/fixtures/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/Developer/soul-dreams-docs",
        "~/Developer/soul-dreams",
        "~/.soul-dreams",
        "~/.aws",
        "~/.ssh",
        "~/Downloads",
        "~/Library/Mobile Documents",
        "~/Library/CloudStorage"
      ],
      "denyWrite": [
        "./.githooks",
        "./tool/checks",
        "./tool/check_all.sh",
        "./app/assets/words",
        "./app/lib/words",
        "./docs/source",
        "./fixtures",
        "./.git/config",
        "./.git/hooks"
      ],
      "allowWrite": [
        "~/.pub-cache",
        "~/fvm",
        "~/.dartServer",
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "pub.dev",
        "*.pub.dev",
        "storage.googleapis.com",
        "registry.npmjs.org"
      ]
    }
  }
}
